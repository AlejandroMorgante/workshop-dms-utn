locals {
  dms_trust = jsonencode({
    Version   = "2012-10-17"
    Statement = [{ Effect = "Allow", Principal = { Service = "dms.amazonaws.com" }, Action = "sts:AssumeRole" }]
  })
}

# AWS DMS requires these account-level role names. Existing roles can be reused.
resource "aws_iam_role" "vpc" {
  count              = var.create_dms_vpc_role ? 1 : 0
  name               = "dms-vpc-role"
  assume_role_policy = local.dms_trust
}
resource "aws_iam_role_policy_attachment" "vpc" {
  count      = var.create_dms_vpc_role ? 1 : 0
  role       = aws_iam_role.vpc[0].name
  policy_arn = "arn:${local.partition}:iam::aws:policy/service-role/AmazonDMSVPCManagementRole"
}
resource "aws_iam_role" "logs" {
  count              = var.create_dms_logs_role ? 1 : 0
  name               = "dms-cloudwatch-logs-role"
  assume_role_policy = local.dms_trust
}
resource "aws_iam_role_policy_attachment" "logs" {
  count      = var.create_dms_logs_role ? 1 : 0
  role       = aws_iam_role.logs[0].name
  policy_arn = "arn:${local.partition}:iam::aws:policy/service-role/AmazonDMSCloudWatchLogsRole"
}

resource "aws_iam_role" "source" {
  name_prefix = "${var.workshop_name}-dms-source-"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "dms.${var.aws_region}.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}
resource "aws_iam_role_policy" "source" {
  role = aws_iam_role.source.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow", Action = ["secretsmanager:GetSecretValue", "secretsmanager:DescribeSecret"]
        Resource = aws_secretsmanager_secret.source.arn

      }
    ]
  })
}

resource "aws_iam_role" "target" {
  name_prefix        = "${var.workshop_name}-dms-target-"
  assume_role_policy = local.dms_trust
}
resource "aws_iam_role_policy" "target" {
  role = aws_iam_role.target.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = ["s3:GetBucketLocation", "s3:ListBucket", "s3:ListBucketMultipartUploads"]
        Resource = local.storage.bucket_arn
      },
      {
        Effect   = "Allow"
        Action   = ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:PutObjectTagging", "s3:PutObjectAcl", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"]
        Resource = "${local.storage.bucket_arn}/*"
      },
      {
        Effect = "Allow"
        Action = ["glue:CreateDatabase", "glue:GetDatabase", "glue:CreateTable", "glue:DeleteTable", "glue:UpdateTable", "glue:GetTable", "glue:BatchCreatePartition", "glue:CreatePartition", "glue:UpdatePartition", "glue:GetPartition", "glue:GetPartitions", "glue:BatchGetPartition"]
        # Names are generated by DMS; constrain account/region, not a guessed name.
        Resource = ["arn:${local.partition}:glue:${local.region}:${local.account}:catalog", "arn:${local.partition}:glue:${local.region}:${local.account}:database/*", "arn:${local.partition}:glue:${local.region}:${local.account}:table/*/*"]
      },
      {
        Effect   = "Allow"
        Action   = ["athena:CreateWorkGroup", "athena:StartQueryExecution", "athena:GetQueryExecution"]
        Resource = "arn:${local.partition}:athena:${local.region}:${local.account}:workgroup/glue_catalog_generation_for_task_*"
      }
    ]
  })
}
